# ==========================================
# Dependencies
# ==========================================
/node_modules
/.pnp
.pnp.js

# ==========================================
# Production & Build Outputs
# ==========================================
/build
/dist
/out
/.next
/.vite

# ==========================================
# Environment Variables & Secrets
# ==========================================
# Ignore local environment files containing API keys/secrets
.env
.env.*

# DO NOT ignore the template file if you use one
!.env.example

# ==========================================
# Logs & Testing
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/coverage

# ==========================================
# Editor & IDE (VS Code)
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/

# ==========================================
# Operating System Files
# ==========================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/

# Linux & macOS
.DS_Store
.apple_desktop
.LSOverride
*~

# ==========================================
# Package Manager Caches & Lockfiles
# ==========================================
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
